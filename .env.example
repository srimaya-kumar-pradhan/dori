# DORI Backend

## Environment Variables
DATABASE_URL=postgresql://dori:dori_dev_password@localhost:5432/dori
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=dev-encryption-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# External Services (mock in development)
SMS_PROVIDER_KEY=mock
VOICE_PROVIDER_KEY=mock
ABDM_API_URL=mock
ABDM_CLIENT_ID=mock
ABDM_CLIENT_SECRET=mock
ESANJEEVANI_API_URL=mock
ESANJEEVANI_API_KEY=mock

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# ML/Federated
MODEL_PROVIDER=mock
FEDERATED_NODE_ID=dev-node-001

# SMTP Email Alerts (Server-Side ONLY - Never expose to client)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DORI Care Continuity <notifications@dori.gov.in>"
